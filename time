  {k:'運動',c:'#10b981',rx:['運動','ジム','ラン','筋トレ','走']},
  {k:'ダラダラ',c:'#ef4444',rx:['だらだら','ダラダラ','サーフィン','ネット','sns','スマホ','youtube','動画']},
  {k:'移動',c:'#78716c',rx:['通学','下校','電車','ドライブ','外出','移動','帰宅','通勤']},
  {k:'生活',c:'#94a3b8',rx:['風呂','準備','起床','休憩','掃除','買い物']},
  {k:'その他',c:'#6b7280',rx:[]},
];
const CMAP=Object.fromEntries(CATS.map(x=>[x.k,x.c]));
const CSET=new Set(CATS.map(x=>x.k));
const ORDER=CATS.map(x=>x.k);
const DOWJ=['日','月','火','水','木','金','土'];
const WD=['月','火','水','木','金'],WE=['土','日'];
const SLOTS=48;
let STATE={};            // `${iso}#${slot}` -> {cat,note}
function mondayOf(d){const x=new Date(d);const g=(x.getDay()+6)%7;x.setDate(x.getDate()-g);x.setHours(0,0,0,0);return x;}
let weekStart=mondayOf(new Date());   // 今週(月曜始まり)
let curDay=0, mode='paint', armed=null, memoTarget=null;
let tab='rec', scope='all';

function iso(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function addDays(d,n){const x=new Date(d);x.setDate(x.getDate()+n);return x;}
function slotTime(s){const h=Math.floor(s/2),m=(s%2)?'30':'00';return String(h).padStart(2,'0')+':'+m;}
function weekDays(){const a=[];for(let i=0;i<7;i++){const dt=addDays(weekStart,i);a.push({dt,iso:iso(dt),md:(dt.getMonth()+1)+'/'+dt.getDate(),dow:DOWJ[dt.getDay()]});}return a;}
function classify(t){const s=t.toLowerCase();for(const c of CATS){for(const r of c.rx){if(s.includes(r))return c.k;}}return 'その他';}
function flash(){const s=document.getElementById('saved');s.classList.add('show');clearTimeout(flash._t);flash._t=setTimeout(()=>s.classList.remove('show'),700);}

/* ---------- persistence (localStorage) ---------- */
const LS_KEY='tt-state-v1';
function persist(){
  flash();
  try{localStorage.setItem(LS_KEY,JSON.stringify(STATE));}
  catch(e){console.error('save failed',e);}
}
function loadState(){
  try{const r=localStorage.getItem(LS_KEY);if(r)STATE=JSON.parse(r)||{};}catch(e){STATE={};}
}

/* ---------- serialize / parse ---------- */
function serialize(){
  let out='';
  weekDays().forEach(d=>{
    out+=`━━━━━ ${d.md}(${d.dow}) ━━━━━\n`;
    for(let s=0;s<SLOTS;s++){
      const v=STATE[d.iso+'#'+s];
      out+=slotTime(s)+(v?(' '+v.cat+(v.note?' '+v.note:'')):'')+'\n';
    }
  });
  return out;
}
function parseInto(txt){
  const lines=txt.split('\n');
  const dateRe=/(\d{1,2})\/(\d{1,2})/;
  const timeRe=/^\s*(\d{1,2}):(\d{2})\s*(.*)$/;
  let curIso=null;
  const yr=weekStart.getFullYear();
  for(const ln of lines){
    const tm=ln.match(timeRe);
    if(!tm){const m=ln.match(dateRe);if(m){curIso=yr+'-'+String(+m[1]).padStart(2,'0')+'-'+String(+m[2]).padStart(2,'0');}continue;}
    if(!curIso)continue;
    const h=+tm[1],mi=+tm[2],text=tm[3].trim();
    const slot=h*2+(mi>=30?1:0);
    const key=curIso+'#'+slot;
    if(!text){delete STATE[key];continue;}
    const toks=text.split(/\s+/);
    let cat,note;
    if(CSET.has(toks[0])){cat=toks[0];note=toks.slice(1).join(' ');}
    else{cat=classify(text);note=text;}
    STATE[key]={cat,note};
  }
}

/* ---------- prefill (last week, hourly -> 30min) ---------- */
const PREFILL=`
6/24(水)|00 だらだら|01 だらだら|02 睡眠|03 睡眠|04 睡眠|05 睡眠|06 睡眠|07 睡眠|08 睡眠|09 起床 09:15〜通学|10 通学〜10:40 実験液作り|11 実験液作り〜11:30 実験|12 実験〜12:25 バイト12:30〜|13 バイト|14 バイト〜14:30|15 実験|16 実験 お昼15分|17 休憩|18 バイト|19 バイト〜19:30 下校|20 下校|21 21:05帰宅 夜ご飯|22 論文読み|23 だらだら
