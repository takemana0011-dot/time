<style>
  :root{
    --bg:#0c0f12; --panel:#14181d; --panel2:#1a1f26; --grid:#262d35;
    --txt:#cdd6df; --dim:#7b858e; --dimmer:#4a525b; --accent:#34d399;
    --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
    --sans:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic UI",sans-serif;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  body{margin:0 auto;background:var(--bg);color:var(--txt);font-family:var(--sans);max-width:600px;padding:12px 12px 70px;}
  h1{font-size:15px;font-weight:600;margin:0 0 2px;letter-spacing:.03em;}
  .sub{font-family:var(--mono);font-size:11px;color:var(--dim);margin-bottom:10px;}
  button{font-family:var(--mono);cursor:pointer;}

  .tabs{display:flex;gap:5px;margin-bottom:12px;}
  .tabs>button{flex:1;font-size:13px;padding:9px 0;border:1px solid var(--grid);background:var(--panel);color:var(--dim);border-radius:7px;}
  .tabs>button.on{background:var(--txt);color:var(--bg);border-color:var(--txt);font-weight:700;}

  .navbar{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
  .navbar button{background:var(--panel);border:1px solid var(--grid);color:var(--txt);border-radius:6px;padding:5px 10px;font-size:13px;}
  .navbar .rng{font-family:var(--mono);font-size:12px;color:var(--dim);flex:1;text-align:center;}

  .days,.dayrow{display:flex;gap:4px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:2px;margin-bottom:12px;}
  .days button,.dayrow button{flex:0 0 auto;width:44px;padding:6px 0;border:1px solid var(--grid);background:var(--panel);color:var(--dim);border-radius:6px;font-size:10px;line-height:1.4;text-align:center;}
  .days button b,.dayrow button b{display:block;font-size:14px;color:var(--txt);}
  .days button.on{border-color:var(--accent);background:var(--panel2);}
  .days button.on b{color:var(--accent);}
  .dayrow button.on{border-color:var(--txt);background:var(--panel2);}

  .palette{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px;}
  .chip{font-size:12px;padding:5px 9px;border-radius:14px;border:1px solid var(--grid);background:var(--panel);color:var(--dim);display:flex;align-items:center;gap:6px;}
  .chip .dot{width:9px;height:9px;border-radius:50%;}
  .chip.armed{color:var(--txt);box-shadow:inset 0 0 0 1.5px currentColor;}
  .toolbar{display:flex;gap:6px;margin-bottom:10px;align-items:center;flex-wrap:wrap;}
  .toolbar .mode{display:flex;gap:4px;}
  .toolbar .mode button{font-size:11px;padding:5px 9px;border:1px solid var(--grid);background:var(--panel);color:var(--dim);border-radius:5px;}
  .toolbar .mode button.on{background:var(--accent);color:var(--bg);border-color:var(--accent);font-weight:700;}
  .toolbar .mode button.on.memo{background:#fbbf24;border-color:#fbbf24;}
  .toolbar .act{margin-left:auto;display:flex;gap:6px;}
  .toolbar .act button{font-size:11px;padding:6px 10px;border:1px solid var(--grid);background:var(--panel);color:var(--txt);border-radius:6px;}
  .hint{font-size:11px;color:var(--dim);font-family:var(--mono);margin-bottom:8px;}

  .grid{border:1px solid var(--grid);border-radius:8px;overflow:hidden;background:var(--panel);}
  .row{display:flex;align-items:stretch;border-bottom:1px solid var(--grid);min-height:26px;}
  .row:last-child{border-bottom:none;}
  .row.hh{border-top:1px solid #2f3742;}
  .row .t{flex:0 0 50px;font-family:var(--mono);font-size:10.5px;color:var(--dimmer);display:flex;align-items:center;padding-left:8px;border-right:1px solid var(--grid);}
  .row.hh .t{color:var(--dim);}
  .row .bar{flex:0 0 4px;background:transparent;}
