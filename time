6/27(土)|00 睡眠|01 睡眠|02 睡眠|03 睡眠|04 睡眠|05 睡眠|06 睡眠|07 睡眠|08 睡眠|09 睡眠 9:45起床|10 準備|11 外出|12 電車|13 電車 敦賀着|14 会う|15 会う|16 会う|17 会う|18 会う|19 会う|20 夜ご飯 福井駅|21 会う|22 会う|23 会う
6/28(日)|00 睡眠|01 睡眠|02 睡眠|03 睡眠|04 睡眠|05 睡眠|06 睡眠|07 睡眠|08 睡眠|09 睡眠|10 睡眠|11 だらだら|12 ドライブ|13 お昼|14 ドライブ|15 論文読み|16 論文読み|17 お昼寝|18 ドライブ|19 ドライブ|20 敦賀発|21 電車|22 帰宅|23 お風呂
6/29(月)|00 睡眠|01 睡眠|02 睡眠|03 睡眠|04 睡眠|05 睡眠|06 睡眠|07 起床 7:50〜通学|08 通学|09 講義|10 講義|11 バイト|12 バイト〜13:00|13 お昼|14 岡本さんと対話|15 論文読み|16 論文読み|17 論文読み|18 野口さん|19 野口さん〜19:30|20 下校|21 下校|22 帰宅 夜ご飯|23 お風呂
6/30(火)|00 睡眠|01 睡眠|02 睡眠|03 睡眠|04 睡眠|05 睡眠|06 睡眠|07 睡眠|08 睡眠|09 起床 通学|10 通学 10:50〜実験|11 実験|12 実験|13 実験|14 ワークショップ応募文章|15 実験 お昼15分|16 実験|17 実験|18 実験|19 実験|20 下校|21 下校 21:20帰宅|22 論文読み|23 論文読み`;
function seedPrefill(){
  const yr=2026;
  PREFILL.trim().split('\n').forEach(line=>{
    const parts=line.split('|');
    const md=parts[0].match(/(\d+)\/(\d+)/);
    const diso=yr+'-'+String(+md[1]).padStart(2,'0')+'-'+String(+md[2]).padStart(2,'0');
    for(let i=1;i<parts.length;i++){
      const m=parts[i].match(/^(\d{1,2})\s+(.*)$/);if(!m)continue;
      const h=+m[1],text=m[2].trim();
      const cat=classify(text);
      STATE[diso+'#'+(h*2)]={cat,note:text};
      STATE[diso+'#'+(h*2+1)]={cat,note:''};
    }
  });
}

/* ---------- record UI ---------- */
function renderSub(){
  const d=weekDays();
  document.getElementById('sub').textContent=`${d[0].md}–${d[6].md} · 自動保存`;
  document.getElementById('rng').textContent=`${d[0].md}(${d[0].dow}) – ${d[6].md}(${d[6].dow})`;
}
function renderDays(){
  const el=document.getElementById('days');el.innerHTML='';
  weekDays().forEach((d,i)=>{
    const b=document.createElement('button');b.className=(i===curDay?'on':'');
    b.innerHTML=`${d.dow}<b>${d.dt.getDate()}</b>`;b.onclick=()=>{curDay=i;memoTarget=null;renderRec();};
    el.appendChild(b);
  });
}
function renderPalette(){
  const el=document.getElementById('palette');el.innerHTML='';
  CATS.forEach(c=>{
    const n=document.createElement('div');n.className='chip'+(armed===c.k?' armed':'');
    n.style.color=armed===c.k?c.c:'';
    n.innerHTML=`<span class="dot" style="background:${c.c}"></span>${c.k}`;
    n.onclick=()=>{armed=armed===c.k?null:c.k;renderPalette();};
    el.appendChild(n);
  });
}
function renderMemo(){
  const box=document.getElementById('memoBox');box.innerHTML='';
  if(memoTarget===null)return;
  const key=weekDays()[curDay].iso+'#'+memoTarget;const v=STATE[key]||{};
  const wrap=document.createElement('div');wrap.className='memoedit';
  const inp=document.createElement('input');inp.placeholder=`${slotTime(memoTarget)} 何してた？`;inp.value=v.note||'';
  inp.oninput=()=>{const c=STATE[key]||{};c.note=inp.value;if(!inp.value&&!c.cat)delete STATE[key];else STATE[key]=c;};
  inp.onblur=()=>{persist();renderGrid();};
  inp.onkeydown=e=>{if(e.key==='Enter'){inp.blur();memoTarget=null;renderRec();}};
  wrap.appendChild(inp);box.appendChild(wrap);setTimeout(()=>inp.focus(),30);
}
function renderGrid(){
  const g=document.getElementById('grid');g.innerHTML='';
  const diso=weekDays()[curDay].iso;
  for(let s=0;s<SLOTS;s++){
    const v=STATE[diso+'#'+s];
    const row=document.createElement('div');row.className='row'+(s%2===0?' hh':'');
    const col=(v&&v.cat)?CMAP[v.cat]:'transparent';
    row.innerHTML=`<div class="t">${slotTime(s)}</div><div class="bar" style="background:${col}"></div>`+
      `<div class="cell">${(v&&v.cat)?`<span class="lab" style="color:${CMAP[v.cat]}">${v.cat}</span>`:''}`+
      `${v&&v.note?`<span class="nt">${esc(v.note)}</span>`:''}</div>`;
    row.onclick=()=>onSlot(s);
    g.appendChild(row);
  }
}
function onSlot(s){
  try{
  const key=weekDays()[curDay].iso+'#'+s;
  if(mode==='paint'){
    if(!armed){const h=document.getElementById('hint');h.style.color='#fbbf24';setTimeout(()=>h.style.color='',500);return;}
    const v=STATE[key];
    if(v&&v.cat===armed){if(v.note)STATE[key]={note:v.note};else delete STATE[key];}
    else STATE[key]={...(v||{}),cat:armed};
    renderGrid();persist();
  }else{memoTarget=(memoTarget===s)?null:s;renderRec();}
  }catch(e){console.error(e);}
}
function setMode(m){mode=m;memoTarget=null;
  document.getElementById('mPaint').className=m==='paint'?'on':'';
  document.getElementById('mMemo').className=m==='memo'?'on memo':'';
  document.getElementById('hint').textContent=m==='paint'?'カテゴリを選んで30分枠をタップ。連続で塗れる。同じのを再タップで消去。':'枠をタップして詳細メモを追加。';
  renderRec();
}
function clearDay(){
  const diso=weekDays()[curDay].iso;
  if(!confirm(weekDays()[curDay].md+' の記録を消す？'))return;
  for(let s=0;s<SLOTS;s++)delete STATE[diso+'#'+s];
  renderGrid();persist();
}
function shiftWeek(n){weekStart=addDays(weekStart,7*n);curDay=0;memoTarget=null;renderRec();if(tab==='ana')renderAna();}
function renderRec(){renderSub();renderDays();renderPalette();renderMemo();renderGrid();}

function copyLog(){
  const txt=serialize();
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(()=>toast('コピーした→Notesに貼って'),()=>fallbackCopy(txt));
  }else fallbackCopy(txt);
}
function fallbackCopy(txt){
  const d=document.querySelector('.io');d.open=true;
  const ta=document.getElementById('pasteArea');ta.value=txt;ta.select();
  try{document.execCommand('copy');toast('コピーした→Notesに貼って');}catch(e){toast('下の枠から手動でコピー');}
}
function loadPaste(){
  const txt=document.getElementById('pasteArea').value;
  if(!txt.trim())return;
  parseInto(txt);persist();renderRec();if(tab==='ana')renderAna();toast('読込完了');
}
function toast(m){const s=document.getElementById('saved');s.textContent=m;s.classList.add('show');clearTimeout(toast._t);toast._t=setTimeout(()=>{s.classList.remove('show');s.textContent='保存';},1400);}

/* ---------- analysis ---------- */
function esc(s){return String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
function buildDays(){
  return weekDays().map(d=>{
    const cats={},seq=[],entries=[];
    for(let s=0;s<SLOTS;s++){
      const v=STATE[d.iso+'#'+s];
      if(v&&v.cat){cats[v.cat]=(cats[v.cat]||0)+0.5;seq.push(v.cat);entries.push({time:slotTime(s),cat:v.cat,note:v.note||''});}
      else seq.push(null);
    }
    return {md:d.md,dow:d.dow,cats,seq,entries};
  });
}
function longestRun(seq,cat){let b=0,c=0;for(const x of seq){c=(x===cat)?c+1:0;b=Math.max(b,c);}return b*0.5;}
function agg(ds){const cats={};let total=0;ds.forEach(d=>{for(const k in d.cats){cats[k]=(cats[k]||0)+d.cats[k];total+=d.cats[k];}});return {cats,total};}
function donut(items,total){
  const cx=78,cy=78,R=58,W=30,C=2*Math.PI*R;let off=0,seg='';const t=total||1;
  items.forEach(d=>{const len=d.v/t*C;seg+=`<circle cx="${cx}" cy="${cy}" r="${R}" fill="none" stroke="${d.c}" stroke-width="${W}" stroke-dasharray="${len} ${C-len}" stroke-dashoffset="${-off}" transform="rotate(-90 ${cx} ${cy})"/>`;off+=len;});
  return `<svg width="156" height="156" viewBox="0 0 156 156">${seg}<text x="${cx}" y="${cy-2}" text-anchor="middle" font-size="22" fill="#cdd6df" font-weight="700" font-family="ui-monospace,monospace">${total.toFixed(total%1?1:0)}</text><text x="${cx}" y="${cy+16}" text-anchor="middle" font-size="10" fill="#7b858e">h 記録</text></svg>`;
}
function cards(cats,n,ds){
  const g=k=>cats[k]||0;
  const work=g('実験')+g('研究')+g('講義学習')+g('バイト');
  const skill=g('英語')+g('Python')+g('note')+g('neuroarts')+g('運動');
  const sleep=n>1?(g('睡眠')/n).toFixed(1)+'h':g('睡眠')+'h';
  const maxE=Math.max(0,...ds.map(d=>longestRun(d.seq,'実験')));
  const A=[['実働',work+'h',0],[n>1?'睡眠/日':'睡眠',sleep,0],['スキル制作',skill+'h',skill===0],['ダラダラ',g('ダラダラ')+'h',1],['移動',g('移動')+'h',0],['実験 最長連続',maxE+'h',0]];
  return '<div class="cards">'+A.map(([l,v,w])=>`<div class="card"><div class="cv" style="color:${w?'#ef4444':'var(--txt)'}">${v}</div><div class="cl">${l}</div></div>`).join('')+'</div>';
}
function setScope(s){scope=s;renderAna();}
function renderDayRow(days){
  const el=document.getElementById('dayrow');el.innerHTML='';
  days.forEach((d,i)=>{const b=document.createElement('button');b.dataset.d=i;b.innerHTML=`${d.dow}<b>${d.md.split('/')[1]}</b>`;b.onclick=()=>setScope(i);el.appendChild(b);});
}
function renderAna(){
  const days=buildDays();
  renderDayRow(days);
  document.querySelectorAll('#scopeTabs button').forEach(b=>b.classList.toggle('on',typeof scope==='string'&&b.dataset.s===scope));
  document.querySelectorAll('#dayrow button').forEach(b=>b.classList.toggle('on',scope===+b.dataset.d));
  let sel,label;
  if(scope==='all'){sel=days;label='1週間';}
  else if(scope==='wd'){sel=days.filter(d=>WD.includes(d.dow));label='平日';}
  else if(scope==='we'){sel=days.filter(d=>WE.includes(d.dow));label='休日';}
  else{sel=days[scope]?[days[scope]]:[];label=days[scope]?`${days[scope].md}(${days[scope].dow})`:'';}
  const {cats,total}=agg(sel);
  const items=ORDER.map(k=>({k,v:cats[k]||0,c:CMAP[k]})).filter(x=>x.v>0).sort((a,b)=>b.v-a.v);
  let html=`<div class="piewrap">${donut(items,total)}<div class="legend">`+
    (items.length?items.map(d=>`<div class="lrow"><i style="background:${d.c}"></i><span class="n">${d.k}</span><span class="v">${d.v}h ${(d.v/total*100).toFixed(0)}%</span></div>`).join(''):'<span class="v">記録なし</span>')+`</div></div>`;
  html+=`<h2>${label}・指標${sel.length>1?'（'+sel.length+'日）':''}</h2>`+cards(cats,sel.length,sel);
  if(sel.length>1){
    html+='<h2>日別の構成</h2>';
    sel.forEach(d=>{const tot=Object.values(d.cats).reduce((a,b)=>a+b,0);const wk=(d.cats['実験']||0)+(d.cats['研究']||0)+(d.cats['講義学習']||0)+(d.cats['バイト']||0);
      html+=`<div class="day"><div class="dh"><span>${d.md}(${d.dow})</span><span>実働${wk}h · 記録${tot}h</span></div><div class="stack">`;
      ORDER.forEach(k=>{const h=d.cats[k];if(h)html+=`<div class="seg" style="width:${h/24*100}%;background:${CMAP[k]}"></div>`;});
      html+='</div></div>';});
  }else if(sel.length===1){
    html+='<h2>この日の詳細</h2><div class="det">';
    sel[0].entries.forEach(e=>{html+=`<div class="drow"><span class="dt">${e.time}</span><span class="db" style="background:${CMAP[e.cat]}"></span><span class="dc"><span class="dcat" style="color:${CMAP[e.cat]}">${e.cat}</span>${e.note?`<span class="dtxt">${esc(e.note)}</span>`:''}</span></div>`;});
    html+='</div><div class="note">詳細は「記録」タブでメモモードにして各枠に追記→ここに反映。</div>';
  }
  document.getElementById('anaOut').innerHTML=html;
}

function setTab(t){tab=t;
  document.getElementById('tabRec').className=t==='rec'?'on':'';
  document.getElementById('tabAna').className=t==='ana'?'on':'';
  document.getElementById('rec').style.display=t==='rec'?'':'none';
  document.getElementById('ana').style.display=t==='ana'?'':'none';
  if(t==='ana')renderAna();
}

/* ---------- init ---------- */
function init(){
  loadState();
  if(Object.keys(STATE).length===0){ seedPrefill(); persist(); }
  renderRec();
}
init();
</script>
